      { "id": "wait", "sourceQuote": "real 61 second wait", "claim": "P to D uses real monotonic time and server ticks", "oracle": { "type": "game_assertion", "assertion": { "type": "elapsed_between", "fromCheckpoint": "P", "toCheckpoint": "D", "minMs": 60000, "maxMs": 75000, "minWorldTicks": 1200 } } },
      { "id": "death-screen", "sourceQuote": "DeathScreen", "claim": "The player really dies and reaches the death screen", "oracle": { "type": "game_assertion", "assertion": { "type": "screen_matches", "screenName": "DeathScreen", "checkpoint": "D" } } },
