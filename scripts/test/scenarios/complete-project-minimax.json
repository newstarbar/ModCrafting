      { "id": "not-recent", "sourceQuote": "not A or C", "claim": "R is not the recent A or death-before C state", "oracle": { "type": "game_assertion", "assertion": { "type": "snapshot_relation", "left": { "checkpoint": "R", "source": "serverPlayer", "pointer": "/x" }, "right": { "checkpoint": "A", "source": "serverPlayer", "pointer": "/x" }, "operator": "not_equals", "normalizer": "player_state_v1" } } },
      { "id": "not-death-state", "sourceQuote": "not C", "claim": "R is not the death-before C state", "oracle": { "type": "game_assertion", "assertion": { "type": "snapshot_relation", "left": { "checkpoint": "R", "source": "serverPlayer", "pointer": "/x" }, "right": { "checkpoint": "C", "source": "serverPlayer", "pointer": "/x" }, "operator": "not_equals", "normalizer": "player_state_v1" } } },
      { "id": "uuid", "sourceQuote": "UUID remains", "claim": "R retains P UUID", "oracle": { "type": "game_assertion", "assertion": { "type": "snapshot_relation", "left": { "checkpoint": "P", "source": "serverPlayer", "pointer": "/uuid" }, "right": { "checkpoint": "R", "source": "serverPlayer", "pointer": "/uuid" }, "operator": "equals" } } },
      { "id": "inventory", "sourceQuote": "complete inventory", "claim": "Full normalized inventory is restored", "oracle": { "type": "game_assertion", "assertion": { "type": "snapshot_relation", "left": { "checkpoint": "P", "source": "serverPlayer", "pointer": "/inventory" }, "right": { "checkpoint": "R", "source": "serverPlayer", "pointer": "/inventory" }, "operator": "equals", "normalizer": "inventory_v1" } } }
    ]
