{
	"name": "modcrafting",
	"type": "module",
	"version": "0.1.5",
	"description": "ModCrafting Fabric Core, MCP tools, and visual workbench",
	"author": "newstarbar",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/newstarbar/ModCrafting.git"
	},
	"engines": {
		"node": ">=22.15.0"
	},
	"packageManager": "pnpm@10.34.7",
	"scripts": {
		"dev": "pnpm run plugin:build && pnpm run view:start",
		"build": "pnpm run plugin:build && pnpm run bench:build",
		"preview": "pnpm run view:start",
		"start": "pnpm run view:start",
		"typecheck": "pnpm run plugin:typecheck && pnpm run view:typecheck",
		"test": "pnpm run plugin:test",
		"plugin:build": "node scripts/plugin/build.mjs",
		"plugin:qoder": "node scripts/plugin/stage-qoder.mjs",
		"plugin:smoke:experience": "node scripts/plugin/smoke-experience.mjs",
		"view:start": "node plugins/modcrafting-fabric/dist/mcp-server.js --web-only",
		"view:typecheck": "tsc --noEmit --module esnext --moduleResolution bundler --target es2023 --jsx react-jsx --lib es2023,dom --allowImportingTsExtensions --esModuleInterop --skipLibCheck packages/modcrafting-view/src/main.tsx",
		"plugin:test": "node scripts/plugin/test.mjs",
		"bench:fabric": "node --experimental-strip-types scripts/bench/run-fabric-bench.ts",
		"bench:fabric:live": "node --experimental-strip-types scripts/bench/run-fabric-bench-live.ts",
		"bench:build": "node scripts/bench/build.mjs",
		"plugin:validate": "node scripts/plugin/validate.mjs",
		"plugin:stage": "node scripts/plugin/stage.mjs",
		"product:stage": "node scripts/plugin/stage-product.mjs",
		"host:config": "node scripts/plugin/host-config.mjs",
		"host:stage": "node scripts/plugin/stage-hosts.mjs",
		"host:smoke": "node scripts/plugin/smoke-hosts.mjs",
		"plugin:smoke": "node scripts/plugin/smoke.mjs",
		"plugin:typecheck": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --allowImportingTsExtensions --esModuleInterop --skipLibCheck plugins/modcrafting-fabric/src/mcp-server.ts packages/modcrafting-core/src/index.ts scripts/bench/run-fabric-bench.ts scripts/bench/run-fabric-bench-live.ts",
		"candidate:build": "node scripts/plugin/build-candidate.mjs",
		"builder:build": "node scripts/plugin/build-builder.mjs",
		"release:package": "node scripts/release/package-release.mjs",
		"acceptance:first-use": "node --experimental-strip-types scripts/acceptance/run-first-use.mjs",
		"docs:sync-fabric": "node --experimental-strip-types scripts/sync-fabric-docs-knowledge.ts"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp"
		]
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "2.0.0",
		"@modelcontextprotocol/server": "2.0.0",
		"@types/node": "^22.20.5",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@types/three": "^0.186.0",
		"ajv": "^8.20.0",
		"esbuild": "0.28.2",
		"fast-png": "8.0.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"sharp": "^0.35.2",
		"three": "^0.186.1",
		"typescript": "^5.8.3",
		"unzipper": "^0.12.3",
		"zod": "4.4.3"
	}
}
